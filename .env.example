# Supabase — `npx supabase status` komutu çıktısından alınır.
# NEXT_PUBLIC_ önekli değişkenler tarayıcıya gömülür; buraya asla secret koyma.
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.13:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yalnızca sunucu tarafı: paylaşım görünümünde (plaka + kod doğrulandıktan sonra) kullanılır.
# `npx supabase status` çıktısındaki "Secret" anahtarı. NEXT_PUBLIC_ öneki ALMAZ,
# yalnızca src/lib/supabase/admin.ts ("server-only") tarafından okunur.
SUPABASE_SECRET_KEY=
